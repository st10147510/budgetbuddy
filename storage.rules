rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /profile_photos/{filename} { 
    	// Changed from {userId}.jpg to {filename}
      // The filename should be the user's UID followed by ".jpg"
      allow read, write: if request.auth != null && filename == request.auth.uid + ".jpg";
    }
    match /receipts/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /bank_statements/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
