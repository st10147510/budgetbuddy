<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Geometric art section -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Coral blob — top left, partially off-screen -->
        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_shape_oval_coral"
            android:layout_gravity="top|start"
            android:layout_marginStart="-48dp"
            android:layout_marginTop="-16dp"/>

        <!-- White ring — top right -->
        <View
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_shape_ring_white"
            android:layout_gravity="top|end"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="20dp"/>

        <!-- Cream rounded rect — center -->
        <View
            android:layout_width="64dp"
            android:layout_height="130dp"
            android:background="@drawable/bg_shape_rect_cream"
            android:layout_gravity="center"
            android:layout_marginStart="60dp"
            android:layout_marginTop="40dp"/>

        <!-- Teal ring — bottom left -->
        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_shape_ring_teal"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="8dp"/>

        <!-- Teal tall rect — right center -->
        <View
            android:layout_width="56dp"
            android:layout_height="148dp"
            android:background="@drawable/bg_shape_rect_teal"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="40dp"/>

    </FrameLayout>

    <!-- Text + CTA section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unleash your\nfinancial potential"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Take control of your finances today with smart budgeting, debt tracking, and wealth planning."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="36dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Get Started"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/background"
            app:backgroundTint="@color/cream_accent"
            app:cornerRadius="30dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/btnSignIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Already have an account? Sign In"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="12dp"/>

    </LinearLayout>

</LinearLayout>
