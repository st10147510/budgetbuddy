rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── App-level config (read-only for authenticated users) ──────────────────
    // Policy versions are readable by any authenticated user so the mobile app
    // can check the current required version without server involvement.
    match /app_config/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // only the service account (admin SDK) may write
    }

    // ── Per-user data ─────────────────────────────────────────────────────────
    // Enforce that the caller's Firebase Auth UID matches the path's userId.
    // Prevents any authenticated user from reading or writing another user's data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // All sub-collections (transactions, budgets, goals, debts, badges, etc.)
      match /{collection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
