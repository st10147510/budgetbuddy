rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // All user data lives under users/{userId}/**
    // Enforce that the caller's Firebase Auth UID matches the path's userId.
    // This prevents any authenticated user from reading or writing another
    // user's transactions, budgets, goals, or debts via the REST API or SDK.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
