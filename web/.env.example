APP_NAME="Budget Buddy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false          # NEVER true in production — exposes stack traces
APP_URL=https://thebudgetbuddy.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Stronger bcrypt cost (12 = ~250ms/hash — good balance of security and speed)
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error           # 'debug' in local dev only; never in production

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite
# Production recommendation: switch to PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=budgetbuddy
# DB_USERNAME=budgetbuddy
# DB_PASSWORD=

# ── Session (harden for production) ──────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true        # Encrypt session payload at rest
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true  # HTTPS-only cookies — set false in local HTTP dev
SESSION_SAME_SITE=strict     # Strict SameSite prevents CSRF from third-party pages

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database   # Run: php artisan queue:work --tries=3

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_STORE=database
# Production recommendation: Redis
# CACHE_STORE=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ── Broadcast ─────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ── Filesystem ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Admin (rotate regularly, min 16 chars) ───────────────────────────────────
ADMIN_PASSWORD=

# ── Firebase ──────────────────────────────────────────────────────────────────
# Local: path to service account JSON relative to web/
FIREBASE_CREDENTIALS=firebase-service-account.json
FIREBASE_STORAGE_DEFAULT_BUCKET=

# Docker/cloud: set this env var to the full JSON string instead of a file path
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@thebudgetbuddy.co.za"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
